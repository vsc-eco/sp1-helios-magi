# Prover Network requester private key, or AWS KMS key ARN when USE_KMS_REQUESTER=true.
NETWORK_PRIVATE_KEY=

# Proof fulfillment strategy: auction, hosted, or reserved.
SP1_HELIOS_FULFILLMENT_STRATEGY=auction

# On-chain proof mode: plonk or groth16 (the configured SP1 verifier must accept it).
# magi_operator accepts groth16 only: the Magi zk-header-verifier checks Groth16 proofs.
SP1_HELIOS_PROOF_MODE=groth16

# Set true when NETWORK_PRIVATE_KEY is an AWS KMS key ARN.
USE_KMS_REQUESTER=false

# magi_operator: secp256k1 key (hex) that signs the Magi L2 submitProof / submitHeaders calls.
MAGI_OPERATOR_PRIVATE_KEY=
